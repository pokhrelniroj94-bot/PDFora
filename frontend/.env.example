# Optional PDFora AI — leave disabled until Cloudflare Workers Free is configured.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
PDFORA_CF_WORKERS_FREE_PLAN=false
PDFORA_AI_ENABLED=false
PDFORA_AI_RATE_LIMIT_READY=false

# Optional licensed live NEPSE data provider (ShareHub Data API). Keep server-side only.
